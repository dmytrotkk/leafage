{
  "constraints": {
    "care_profile.care_profile_pkey": "PRIMARY KEY (id)",
    "care_profile.care_profile_substrate_id_fkey": "FOREIGN KEY (substrate_id) REFERENCES substrate(id)",
    "events.events_data_shape": "CHECK (jsonb_matches_schema(event_schema(type), COALESCE(data, 'null'::jsonb)))",
    "events.events_id_owner_id_key": "UNIQUE (id, owner_id)",
    "events.events_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "events.events_photo_path": "CHECK (((type = 'photo'::event_type) = (photo_url IS NOT NULL)))",
    "events.events_pkey": "PRIMARY KEY (id)",
    "events.events_plant_id_owner_id_fkey": "FOREIGN KEY (plant_id, owner_id) REFERENCES plants(id, owner_id)",
    "events.events_plant_required": "CHECK (((plant_id IS NOT NULL) OR (type = ANY (ARRAY['note'::event_type, 'photo'::event_type]))))",
    "events.events_void_reason": "CHECK (((voided_at IS NULL) = (voided_reason IS NULL)))",
    "feed_override.feed_override_dose_factor_check": "CHECK (((dose_factor > (0)::numeric) AND (dose_factor <= (1)::numeric)))",
    "feed_override.feed_override_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "feed_override.feed_override_pkey": "PRIMARY KEY (plant_id, supplement_id)",
    "feed_override.feed_override_plant_id_owner_id_fkey": "FOREIGN KEY (plant_id, owner_id) REFERENCES plants(id, owner_id)",
    "feed_override.feed_override_supplement_id_fkey": "FOREIGN KEY (supplement_id) REFERENCES supplement(id)",
    "pest_case.pest_case_check": "CHECK (((status = 'cleared'::pest_status) = (closed_at IS NOT NULL)))",
    "pest_case.pest_case_check1": "CHECK (((rounds = 0) = (last_treated IS NULL)))",
    "pest_case.pest_case_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "pest_case.pest_case_pkey": "PRIMARY KEY (id)",
    "pest_case.pest_case_plant_id_owner_id_fkey": "FOREIGN KEY (plant_id, owner_id) REFERENCES plants(id, owner_id)",
    "plants.plants_check": "CHECK (((origin_date IS NULL) = (origin_date_precision IS NULL)))",
    "plants.plants_check1": "CHECK (((archived_at IS NULL) = (archived_reason IS NULL)))",
    "plants.plants_check2": "CHECK (((repot_target_cm IS NULL) = (repot_after IS NULL)))",
    "plants.plants_cover_event_id_owner_id_fkey": "FOREIGN KEY (cover_event_id, owner_id) REFERENCES events(id, owner_id)",
    "plants.plants_id_owner_id_key": "UNIQUE (id, owner_id)",
    "plants.plants_individuals_check": "CHECK ((individuals >= 1))",
    "plants.plants_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "plants.plants_owner_id_name_key": "UNIQUE (owner_id, name)",
    "plants.plants_pkey": "PRIMARY KEY (id)",
    "plants.plants_pot_id_owner_id_fkey": "FOREIGN KEY (pot_id, owner_id) REFERENCES pots(id, owner_id)",
    "plants.plants_taxon_id_fkey": "FOREIGN KEY (taxon_id) REFERENCES taxon(id)",
    "plants.plants_water_interval_days_check": "CHECK (((water_interval_days >= 1) AND (water_interval_days <= 60)))",
    "pots.pots_diameter_cm_check": "CHECK ((diameter_cm > (0)::numeric))",
    "pots.pots_height_cm_check": "CHECK ((height_cm > (0)::numeric))",
    "pots.pots_id_owner_id_key": "UNIQUE (id, owner_id)",
    "pots.pots_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "pots.pots_owner_id_label_key": "UNIQUE (owner_id, label)",
    "pots.pots_pkey": "PRIMARY KEY (id)",
    "pots.pots_substrate_id_fkey": "FOREIGN KEY (substrate_id) REFERENCES substrate(id)",
    "profiles.profiles_id_fkey": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "profiles.profiles_pkey": "PRIMARY KEY (id)",
    "profiles.profiles_timezone_check": "CHECK ((('2000-01-01 00:00:00+00'::timestamp with time zone AT TIME ZONE timezone) IS NOT NULL))",
    "programme.programme_dose_factor_check": "CHECK (((dose_factor > (0)::numeric) AND (dose_factor <= (1)::numeric)))",
    "programme.programme_pkey": "PRIMARY KEY (profile_id, supplement_id)",
    "programme.programme_profile_id_fkey": "FOREIGN KEY (profile_id) REFERENCES care_profile(id)",
    "programme.programme_season_end_check": "CHECK (((season_end >= 1) AND (season_end <= 12)))",
    "programme.programme_season_start_check": "CHECK (((season_start >= 1) AND (season_start <= 12)))",
    "programme.programme_supplement_id_fkey": "FOREIGN KEY (supplement_id) REFERENCES supplement(id)",
    "substrate.substrate_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "substrate.substrate_owner_id_label_key": "UNIQUE NULLS NOT DISTINCT (owner_id, label)",
    "substrate.substrate_pkey": "PRIMARY KEY (id)",
    "substrate_part.substrate_part_percent_check": "CHECK (((percent >= 1) AND (percent <= 100)))",
    "substrate_part.substrate_part_pkey": "PRIMARY KEY (substrate_id, component)",
    "substrate_part.substrate_part_substrate_id_fkey": "FOREIGN KEY (substrate_id) REFERENCES substrate(id)",
    "supplement.supplement_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "supplement.supplement_owner_id_label_key": "UNIQUE NULLS NOT DISTINCT (owner_id, label)",
    "supplement.supplement_pkey": "PRIMARY KEY (id)",
    "tasks.tasks_check": "CHECK (((status = 'todo'::task_status) = (completed_at IS NULL)))",
    "tasks.tasks_owner_id_fkey": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE",
    "tasks.tasks_pkey": "PRIMARY KEY (id)",
    "tasks.tasks_plant_id_owner_id_fkey": "FOREIGN KEY (plant_id, owner_id) REFERENCES plants(id, owner_id)",
    "tasks.tasks_priority_check": "CHECK (((priority >= 1) AND (priority <= 3)))",
    "taxon.taxon_pkey": "PRIMARY KEY (id)",
    "taxon.taxon_profile_id_fkey": "FOREIGN KEY (profile_id) REFERENCES care_profile(id)"
  },
