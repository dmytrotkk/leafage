{
  "name": "leafage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun tools/design-check.ts && tsc -b && vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "test": "bun --env-file=.env --env-file=.env.local test",
    "generate": "bun --env-file=.env.local tools/generate.ts",
    "sql": "bun --env-file=.env.local tools/sql.ts",
    "design": "bun tools/design-check.ts",
    "dev:mcp": "bun --env-file=.env --env-file=.env.local tools/dev-mcp.ts",
    "dev:landing": "bun run --filter leafage-landing dev",
    "build:landing": "bun run --filter leafage-landing build",
    "deploy:landing": "bun run build:landing && wrangler deploy -c sites/landing/wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
